<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Food_Planner" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/green_forest</item>
        <item name="colorPrimaryVariant">@color/green_sage</item>
        <item name="colorOnPrimary">@color/white</item>

        <item name="colorSecondary">@color/orange_terracotta</item>
        <item name="colorOnSecondary">@color/white</item>

        <item name="android:windowBackground">@color/cream_background</item>
        <item name="android:statusBarColor">@color/cream_background</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
    </style>

    <style name="ElegantInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxBackgroundColor">@color/white_card</item>
        <item name="boxStrokeColor">@color/green_sage</item>
        <item name="hintTextColor">@color/orange_terracotta</item>
    </style>
</resources>