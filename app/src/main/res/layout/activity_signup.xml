<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/animSignUp"
            android:layout_width="140dp"
            android:layout_height="140dp"
            app:lottie_rawRes="@raw/splash_anim"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            android:layout_marginTop="32dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/tvTitleSign"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/join_the_kitchen"
            style="@style/TextAppearance.FoodPlanner.HeadlineLarge"
            android:textColor="?attr/colorPrimary"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/animSignUp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/create_an_account_to_start_your_journey"
            style="@style/TextAppearance.FoodPlanner.BodyMedium"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvTitleSign"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilUsernameSign"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/name"
            android:layout_marginTop="32dp"
            app:startIconDrawable="@drawable/ic_profile"
            app:startIconTint="?attr/colorSecondary"
            app:layout_constraintTop_toBottomOf="@id/tvSubtitle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etUsernameSign"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName"
                android:textColor="?attr/colorOnSurface"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilEmailSign"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/email"
            android:layout_marginTop="16dp"
            app:startIconDrawable="@drawable/ic_email"
            app:startIconTint="?attr/colorSecondary"
            app:layout_constraintTop_toBottomOf="@id/tilUsernameSign">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEmailSign"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textEmailAddress"
                android:textColor="?attr/colorOnSurface"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPasswordSign"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/password"
            android:layout_marginTop="16dp"
            app:startIconDrawable="@drawable/ic_lock"
            app:startIconTint="?attr/colorSecondary"
            app:passwordToggleEnabled="true"
            app:passwordToggleTint="?attr/colorSecondary"
            app:layout_constraintTop_toBottomOf="@id/tilEmailSign">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPasswordSign"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:textColor="?attr/colorOnSurface"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilConfirmPass"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/confirm_password"
            android:layout_marginTop="16dp"
            app:startIconDrawable="@drawable/ic_lock"
            app:startIconTint="?attr/colorSecondary"
            app:passwordToggleEnabled="true"
            app:passwordToggleTint="?attr/colorSecondary"
            app:layout_constraintTop_toBottomOf="@id/tilPasswordSign">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etConfirmPass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:textColor="?attr/colorOnSurface"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSignUp"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="@string/sign_up"
            android:textSize="18sp"
            android:textStyle="bold"
            app:backgroundTint="?attr/colorSecondary"
            android:textColor="?attr/colorOnSecondary"
            app:cornerRadius="30dp"
            android:layout_marginTop="32dp"
            app:layout_constraintTop_toBottomOf="@id/tilConfirmPass"/>

        <TextView
            android:id="@+id/tvOr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/or_continue_with"
            style="@style/TextAppearance.FoodPlanner.BodyMedium"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/btnSignUp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <LinearLayout
            android:id="@+id/layoutSocial"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/tvOr"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageButton
                android:id="@+id/btnGoogle"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_gmail"
                android:scaleType="centerInside"
                android:layout_marginEnd="24dp"
                tools:ignore="ContentDescription" />

            <ImageButton
                android:id="@+id/btnGuest"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_eye_mask"
                app:tint="?attr/colorSecondary"
                android:scaleType="centerInside"
                tools:ignore="ContentDescription" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="24dp"
            app:layout_constraintTop_toBottomOf="@id/layoutSocial"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/already_a_member"
                style="@style/TextAppearance.FoodPlanner.BodyMedium"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/tvGoToLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/log_in"
                style="@style/TextAppearance.FoodPlanner.LabelLarge"
                android:textColor="?attr/colorSecondary"
                android:textStyle="bold"
                android:layout_marginStart="4dp"/>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>